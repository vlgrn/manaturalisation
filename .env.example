# NaturaGE environment variables
# Copy to .env.local and fill in. The app runs WITHOUT these (state persists to
# localStorage and the paywall is bypassed in dev), so you can develop the UI first
# and wire up Supabase + Stripe when ready.

# --- Supabase (DB + Auth) ---
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key, server-only. NEVER expose to the client. Used by the Stripe webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (one-time payment) ---
STRIPE_SECRET_KEY=
# The price ID of your one-time 39 CHF product (Stripe Dashboard > Products)
STRIPE_PRICE_ID=
# From the Stripe CLI / Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=

# --- App ---
# Public base URL, used for Stripe success/cancel redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
